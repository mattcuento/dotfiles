theme = dark:Gruvbox Dark,light:Gruvbox Light
font-family = Fira Code Mono
# font-family = MesloLGS NF
# font-family = JetBrainsMono Nerd Font Mono
font-size = 12
copy-on-select = clipboard
macos-option-as-alt = true

# Preserve Option+Left/Right as modified arrow keys. Ghostty's defaults emit
# Esc-b/Esc-f, which collide with Zellij's global Alt bindings.
keybind = alt+arrow_left=text:\x1b[1;3D
keybind = alt+arrow_right=text:\x1b[1;3C

# macOS-style text navigation. Send terminal Home/End keys so shells and
# terminal applications can interpret Command+Left/Right consistently.
keybind = super+arrow_left=text:\x1b[H
keybind = super+arrow_right=text:\x1b[F

# cursor trail
custom-shader = ~/.config/ghostty/shaders/shader.glsl
