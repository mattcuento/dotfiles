# Dotfiles Repository - .gitignore
# This repository contains portable configuration files.
# Machine-specific and transient files are excluded.

# ============================================
# System Files
# ============================================

# macOS system files
.DS_Store

# Editor backup files
*~
*.swp
*.swo

# ============================================
# Credentials and application state
# ============================================

.config/gh/hosts.yml
.config/gcloud/
.config/github-copilot/
.config/planetscale/
.config/raycast/

# Pi keeps auth tokens, sessions, caches, and downloaded packages here.
# Reinstall the portable package list from README.md instead of tracking state.
.pi/

# Claude and Codex contain credentials, sessions, caches, and managed skills.
# Track only the explicitly selected, user-authored skill directories.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/gh-stack/
!.claude/skills/jj/

.codex/*
!.codex/skills/
.codex/skills/*
!.codex/skills/gh-stack/
!.codex/skills/jj/
!.codex/skills/tuicr/

# ============================================
# Fish - Lockfile-only tracking
# ============================================
# Track only the source of truth; the rest is installed by fisher.
# On a new machine, run `fisher update` to reinstall everything in
# fish_plugins (fzf.fish, catppuccin, plugin-git, plugin-jj, ...).
#
# fish_variables (universal-variable state) is intentionally NOT tracked.
.config/fish/*
!.config/fish/config.fish
!.config/fish/fish_plugins

# ============================================
# Zellij
# ============================================

# Auto-generated config backups
.config/zellij/*.bak
.config/zellij/*.bak.*

# ============================================
# Jujutsu (jj)
# ============================================

# Per-repository state (not portable)
.config/jj/repos/

# ============================================
# K9s - Portable config and skins only
# ============================================

.config/k9s/*
!.config/k9s/config.yaml
!.config/k9s/skins/

# ============================================
# Neovim - Plugin and Runtime Data
# ============================================

# Plugin data lives in ~/.local/share/nvim/lazy/ (outside this config).
# Test/scratch artifacts (mirrors .config/nvim/.gitignore):
.config/nvim/.tests/
.config/nvim/.repro/
.config/nvim/doc/tags
.config/nvim/data/
.config/nvim/*.log
